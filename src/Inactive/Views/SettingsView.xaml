<UserControl x:Class="Inactive.Views.SettingsView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Inactive.Controls">

  <UserControl.Resources>
    <Style x:Key="SectionNoticeStyle" TargetType="controls:NoticeBar" BasedOn="{StaticResource {x:Type controls:NoticeBar}}">
      <Setter Property="Margin" Value="12,0,12,12" />
      <Setter Property="Visibility" Value="Collapsed" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Margin="16,8,24,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button x:Name="BackButton"
              Style="{StaticResource SubtleButtonStyle}"
              AutomationProperties.Name="Back"
              ToolTip="Back"
              Click="OnBackClick">
        <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE72B;" />
      </Button>
      <TextBlock Grid.Column="1"
                 Style="{StaticResource PageTitleTextStyle}"
                 Margin="8,0,0,0"
                 VerticalAlignment="Center"
                 Text="Settings" />
    </Grid>

    <ScrollViewer Grid.Row="1"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  Focusable="False">
      <StackPanel Margin="24,0,24,24">

        <controls:NoticeBar x:Name="SaveNotice"
                            Severity="Critical"
                            Margin="0,0,0,12"
                            Visibility="Collapsed" />

        <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Unlocking" />
        <Border Style="{StaticResource CardStyle}">
          <StackPanel>
            <controls:SettingRow Title="Unlock key" Description="The key that ends the lock.">
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="UnlockKeyText"
                           Style="{StaticResource SecondaryTextStyle}"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center" />
                <Button Content="Change"
                        AutomationProperties.Name="Change unlock key"
                        Click="OnChangeUnlockKeyClick" />
              </StackPanel>
            </controls:SettingRow>
            <controls:NoticeBar x:Name="UnlockKeyNotice"
                                Style="{StaticResource SectionNoticeStyle}"
                                Severity="Caution" />

            <Border Style="{StaticResource RowDividerStyle}" />

            <controls:SettingRow x:Name="PinRow" Title="PIN" Description="Ask for a PIN after the unlock key.">
              <StackPanel Orientation="Horizontal">
                <Button x:Name="SetPinButton"
                        Content="Set PIN"
                        Click="OnSetPinClick" />
                <Button x:Name="ChangePinButton"
                        Content="Change"
                        AutomationProperties.Name="Change PIN"
                        Click="OnChangePinClick" />
                <Button x:Name="RemovePinButton"
                        Margin="8,0,0,0"
                        Content="Remove"
                        AutomationProperties.Name="Remove PIN"
                        Click="OnRemovePinClick" />
              </StackPanel>
            </controls:SettingRow>
            <controls:NoticeBar x:Name="PinNotice"
                                Style="{StaticResource SectionNoticeStyle}"
                                Severity="Caution" />
          </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Margin="4,20,0,8" Text="Locking" />
        <Border Style="{StaticResource CardStyle}">
          <StackPanel>
            <controls:SettingRow x:Name="HotkeyRow" Title="Lock hotkey">
              <StackPanel Orientation="Horizontal">
                <Button Content="Change"
                        AutomationProperties.Name="Change lock hotkey"
                        Click="OnChangeHotkeyClick" />
                <Button x:Name="HotkeyOffButton"
                        Margin="8,0,0,0"
                        Content="Turn off"
                        AutomationProperties.Name="Turn off lock hotkey"
                        Click="OnHotkeyOffClick" />
              </StackPanel>
            </controls:SettingRow>
            <controls:NoticeBar x:Name="HotkeyNotice"
                                Style="{StaticResource SectionNoticeStyle}"
                                Severity="Caution" />

            <Border Style="{StaticResource RowDividerStyle}" />

            <controls:SettingRow Title="Let the display turn off"
                                 Description="Your PC stays awake, but the screen can go dark. For long locks on an OLED screen, turn this on or use Covered.">
              <ToggleButton x:Name="DisplayOffToggle"
                            Style="{StaticResource ToggleSwitchStyle}"
                            AutomationProperties.Name="Let the display turn off"
                            Click="OnDisplayOffClick" />
            </controls:SettingRow>
          </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Margin="4,20,0,8" Text="Lock screen" />
        <Border Style="{StaticResource CardStyle}">
          <StackPanel>
            <controls:SettingRow Title="Show the clock"
                                 Description="Date and time on the main screen. Not shown in the Visible style.">
              <ToggleButton x:Name="ClockToggle"
                            Style="{StaticResource ToggleSwitchStyle}"
                            AutomationProperties.Name="Show the clock"
                            Click="OnClockClick" />
            </controls:SettingRow>

            <Border Style="{StaticResource RowDividerStyle}" />

            <controls:SettingRow Title="Message" Description="For example, Back in 5 minutes.">
              <TextBox x:Name="MessageBox"
                       Width="200"
                       MaxLength="80"
                       AutomationProperties.Name="Lock screen message"
                       TextChanged="OnMessageChanged"
                       LostKeyboardFocus="OnMessageLostFocus" />
            </controls:SettingRow>

            <Border Style="{StaticResource RowDividerStyle}" />

            <controls:SettingRow Title="Show the unlock key"
                                 Description="Anyone nearby can read it, so this is off by default.">
              <ToggleButton x:Name="HintToggle"
                            Style="{StaticResource ToggleSwitchStyle}"
                            AutomationProperties.Name="Show the unlock key on the lock screen"
                            Click="OnHintClick" />
            </controls:SettingRow>
          </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Margin="4,20,0,8" Text="App" />
        <Border Style="{StaticResource CardStyle}">
          <StackPanel>
            <controls:SettingRow Title="Start with Windows"
                                 Description="Start in the tray when you sign in.">
              <ToggleButton x:Name="StartupToggle"
                            Style="{StaticResource ToggleSwitchStyle}"
                            AutomationProperties.Name="Start with Windows"
                            Click="OnStartupClick" />
            </controls:SettingRow>
            <controls:NoticeBar x:Name="StartupNotice"
                                Style="{StaticResource SectionNoticeStyle}"
                                Severity="Critical" />

            <Border Style="{StaticResource RowDividerStyle}" />

            <controls:SettingRow x:Name="AutoUpdateRow" Title="Automatic updates">
              <ToggleButton x:Name="AutoUpdateToggle"
                            Style="{StaticResource ToggleSwitchStyle}"
                            AutomationProperties.Name="Automatic updates"
                            Click="OnAutoUpdateClick" />
            </controls:SettingRow>

            <Border Style="{StaticResource RowDividerStyle}" />

            <controls:SettingRow x:Name="CheckUpdatesRow" Title="Updates">
              <Button x:Name="CheckUpdatesButton"
                      Content="Check for updates"
                      AutomationProperties.Name="Check for updates"
                      Click="OnCheckUpdatesClick" />
            </controls:SettingRow>
          </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Margin="4,20,0,8" Text="About" />
        <Border Style="{StaticResource CardStyle}" Padding="16,12">
          <StackPanel>
            <TextBlock Style="{StaticResource BodyTextStyle}" Text="Inactive" />
            <TextBlock x:Name="VersionText" Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0" />
            <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0" Text="Copyright (c) 2026 28Y8. MIT license." />
            <WrapPanel Margin="0,12,0,0">
              <TextBlock Margin="0,0,20,0">
                <Hyperlink NavigateUri="https://github.com/28Y8/Inactive" RequestNavigate="OnLinkRequested">Project page</Hyperlink>
              </TextBlock>
              <TextBlock Margin="0,0,20,0">
                <Hyperlink NavigateUri="https://github.com/28Y8/Inactive/releases" RequestNavigate="OnLinkRequested">Release notes</Hyperlink>
              </TextBlock>
              <TextBlock Margin="0,0,20,0">
                <Hyperlink NavigateUri="https://github.com/28Y8/Inactive/issues" RequestNavigate="OnLinkRequested">Report a problem</Hyperlink>
              </TextBlock>
              <TextBlock>
                <Hyperlink NavigateUri="https://github.com/28Y8/Inactive/blob/main/LICENSE" RequestNavigate="OnLinkRequested">License</Hyperlink>
              </TextBlock>
            </WrapPanel>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
