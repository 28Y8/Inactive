<UserControl x:Class="Inactive.Views.HomeView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Inactive.Controls">

  <UserControl.Resources>
    <!-- The previews show the real overlay, which is black and white in every theme. -->
    <SolidColorBrush x:Key="PreviewInkBrush" Color="#FFFFFFFF" />

    <Style x:Key="PreviewScreenStyle" TargetType="Border">
      <Setter Property="Height" Value="64" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorTertiaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="PreviewLineStyle" TargetType="Rectangle">
      <Setter Property="Height" Value="4" />
      <Setter Property="RadiusX" Value="2" />
      <Setter Property="RadiusY" Value="2" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    </Style>

    <Style x:Key="PreviewClockStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="Light" />
      <Setter Property="Foreground" Value="{StaticResource PreviewInkBrush}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Resources>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                Focusable="False">
    <StackPanel Margin="24,16,24,24">

      <controls:NoticeBar x:Name="UpdateNotice"
                          Severity="Success"
                          Margin="0,0,0,12"
                          Visibility="Collapsed">
        <Button Content="Restart"
                AutomationProperties.Name="Restart to update"
                Click="OnRestartClick" />
      </controls:NoticeBar>

      <controls:NoticeBar x:Name="LockNotice"
                          Severity="Critical"
                          Margin="0,0,0,12"
                          Visibility="Collapsed" />

      <controls:NoticeBar x:Name="SettingsNotice"
                          Severity="Caution"
                          Margin="0,0,0,12"
                          Visibility="Collapsed" />

      <Border Style="{StaticResource CardStyle}" Padding="24">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="48"
                    Height="48"
                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                    CornerRadius="24">
              <TextBlock Style="{StaticResource IconTextStyle}"
                         FontSize="22"
                         Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                         Text="&#xE72E;" />
            </Border>
            <TextBlock Grid.Column="1"
                       Style="{StaticResource PageTitleTextStyle}"
                       Margin="16,0,0,0"
                       VerticalAlignment="Center"
                       Text="Ready to lock" />
          </Grid>

          <TextBlock x:Name="BodyText"
                     Style="{StaticResource SecondaryTextStyle}"
                     Margin="0,16,0,0" />

          <WrapPanel Margin="0,12,0,0">
            <Button x:Name="LockButton"
                    Style="{StaticResource AccentButtonStyle}"
                    MinWidth="128"
                    Margin="0,8,16,0"
                    Padding="24,8"
                    AutomationProperties.Name="Lock now"
                    Content="Lock now"
                    Click="OnLockClick" />
            <TextBlock x:Name="HotkeyText"
                       Style="{StaticResource SecondaryTextStyle}"
                       Margin="0,8,0,0"
                       VerticalAlignment="Center" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <TextBlock Style="{StaticResource SectionHeaderTextStyle}"
                 Margin="4,20,0,8"
                 Text="While locked, the screen is" />

      <UniformGrid Columns="3">
        <RadioButton x:Name="VisibleOption"
                     Style="{StaticResource ScreenStyleCardStyle}"
                     Margin="0,0,6,0"
                     GroupName="ScreenStyle"
                     AutomationProperties.Name="Screen style: Visible"
                     AutomationProperties.HelpText="Everything stays readable"
                     Checked="OnStyleChecked">
          <StackPanel>
            <Border Style="{StaticResource PreviewScreenStyle}">
              <Grid>
                <StackPanel Margin="10,12,0,0">
                  <Rectangle Style="{StaticResource PreviewLineStyle}" Width="56" />
                  <Rectangle Style="{StaticResource PreviewLineStyle}" Width="72" Margin="0,6,0,0" />
                  <Rectangle Style="{StaticResource PreviewLineStyle}" Width="40" Margin="0,6,0,0" />
                </StackPanel>
                <Border Width="28"
                        Height="8"
                        Margin="0,0,0,6"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Background="{DynamicResource TextFillColorSecondaryBrush}"
                        CornerRadius="4" />
              </Grid>
            </Border>
            <TextBlock Style="{StaticResource BodyTextStyle}" Margin="2,8,0,0" Text="Visible" />
            <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="2,2,0,0" Text="Stays readable" />
          </StackPanel>
        </RadioButton>

        <RadioButton x:Name="DimmedOption"
                     Style="{StaticResource ScreenStyleCardStyle}"
                     Margin="3,0"
                     GroupName="ScreenStyle"
                     AutomationProperties.Name="Screen style: Dimmed"
                     AutomationProperties.HelpText="Darkened, with a clock"
                     Checked="OnStyleChecked">
          <StackPanel>
            <Border Style="{StaticResource PreviewScreenStyle}">
              <Grid>
                <StackPanel Margin="10,12,0,0">
                  <Rectangle Style="{StaticResource PreviewLineStyle}" Width="56" />
                  <Rectangle Style="{StaticResource PreviewLineStyle}" Width="72" Margin="0,6,0,0" />
                  <Rectangle Style="{StaticResource PreviewLineStyle}" Width="40" Margin="0,6,0,0" />
                </StackPanel>
                <Border Background="Black" Opacity="0.7" />
                <TextBlock Style="{StaticResource PreviewClockStyle}" Text="12:00" />
              </Grid>
            </Border>
            <TextBlock Style="{StaticResource BodyTextStyle}" Margin="2,8,0,0" Text="Dimmed" />
            <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="2,2,0,0" Text="Dark, with a clock" />
          </StackPanel>
        </RadioButton>

        <RadioButton x:Name="CoveredOption"
                     Style="{StaticResource ScreenStyleCardStyle}"
                     Margin="6,0,0,0"
                     GroupName="ScreenStyle"
                     AutomationProperties.Name="Screen style: Covered"
                     AutomationProperties.HelpText="Fully hidden, good for OLED screens"
                     Checked="OnStyleChecked">
          <StackPanel>
            <Border Style="{StaticResource PreviewScreenStyle}">
              <Grid>
                <Border Background="#FF050505" />
                <TextBlock Style="{StaticResource PreviewClockStyle}" Text="12:00" />
              </Grid>
            </Border>
            <TextBlock Style="{StaticResource BodyTextStyle}" Margin="2,8,0,0" Text="Covered" />
            <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="2,2,0,0" Text="Fully hidden" />
          </StackPanel>
        </RadioButton>
      </UniformGrid>

      <Button Style="{StaticResource CardButtonStyle}"
              Margin="0,12,0,0"
              AutomationProperties.Name="Settings"
              AutomationProperties.HelpText="Unlock key, PIN, hotkey and more"
              Click="OnSettingsClick">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Style="{StaticResource IconTextStyle}" FontSize="20" Text="&#xE713;" />
          <StackPanel Grid.Column="1" Margin="16,0,0,0">
            <TextBlock Style="{StaticResource BodyTextStyle}" Text="Settings" />
            <TextBlock Style="{StaticResource CaptionTextStyle}" Text="Unlock key, PIN, hotkey and more" />
          </StackPanel>
          <TextBlock Grid.Column="2"
                     Style="{StaticResource IconTextStyle}"
                     FontSize="12"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                     Text="&#xE76C;" />
        </Grid>
      </Button>

    </StackPanel>
  </ScrollViewer>
</UserControl>
