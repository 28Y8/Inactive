<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Inactive</RootNamespace>
    <AssemblyName>Inactive</AssemblyName>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Inactive.ico</ApplicationIcon>
    <StartupObject>Inactive.Program</StartupObject>
    <!-- App.xaml has no generated Main: Program.Main must run Velopack before any WPF type loads. -->
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- WFO0003 prefers Application.SetHighDpiMode, which only reaches WinForms. This is a WPF app
         and the overlay needs per monitor V2 before the first window, so the manifest sets it. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Applies to dotnet publish -r win-x64. Stays a folder rather than a single file because
       Velopack's delta updates work far better on separate files. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF shares type names with WinForms and System.Drawing, so those are only used by full name. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Inactive.ico" />
    <Resource Include="Assets\InactiveLocked.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Inactive.Core\Inactive.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" />
  </ItemGroup>

</Project>
