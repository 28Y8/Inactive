<Window x:Class="Inactive.Dialogs.NoKeyboardDialog"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inactive"
        Icon="pack://application:,,,/Assets/Inactive.ico"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True">
  <StackPanel Margin="24">
    <TextBlock Style="{StaticResource PageTitleTextStyle}" FontSize="20" Text="Is a keyboard attached?" />
    <TextBlock Style="{StaticResource SecondaryTextStyle}"
               Margin="0,8,0,0"
               Text="This device is in tablet mode. Unlocking needs a physical keyboard, and touch does nothing while locked." />

    <StackPanel Margin="0,24,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
      <Button MinWidth="96"
              Content="Lock anyway"
              Click="OnLockClick" />
      <Button x:Name="CancelButton"
              Style="{StaticResource AccentButtonStyle}"
              MinWidth="96"
              Margin="8,0,0,0"
              Content="Cancel"
              IsDefault="True"
              IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
