<!-- Every key goes to the recorder, so the buttons take no keyboard focus. Enter and Esc confirm and
     cancel instead, as the instructions on screen say. -->
<Window x:Class="Inactive.Dialogs.KeyRecorderDialog"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inactive"
        Icon="pack://application:,,,/Assets/Inactive.ico"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        Focusable="True">
  <StackPanel Margin="24">
    <TextBlock x:Name="HeadingText" Style="{StaticResource PageTitleTextStyle}" FontSize="20" />
    <TextBlock x:Name="InstructionText" Style="{StaticResource SecondaryTextStyle}" Margin="0,8,0,0" />

    <Border Style="{StaticResource KeyCapStyle}" Margin="0,20,0,0" MinWidth="200">
      <TextBlock x:Name="RecordedText"
                 Style="{StaticResource KeyCapTextStyle}"
                 AutomationProperties.LiveSetting="Assertive" />
    </Border>

    <TextBlock x:Name="FeedbackText"
               Style="{StaticResource SecondaryTextStyle}"
               MinHeight="40"
               Margin="0,16,0,0"
               AutomationProperties.LiveSetting="Assertive"
               TextAlignment="Center" />

    <StackPanel Margin="0,8,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
      <Button x:Name="ConfirmButton"
              Style="{StaticResource AccentButtonStyle}"
              MinWidth="96"
              Focusable="False"
              IsEnabled="False"
              Click="OnConfirmClick" />
      <Button MinWidth="96"
              Margin="8,0,0,0"
              Content="Cancel"
              Focusable="False"
              AutomationProperties.Name="Cancel"
              Click="OnCancelClick" />
    </StackPanel>
  </StackPanel>
</Window>
