<Window x:Class="Inactive.Dialogs.PinDialog"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inactive"
        Icon="pack://application:,,,/Assets/Inactive.ico"
        Width="380"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True">

  <Window.Resources>
    <Style x:Key="FieldLabelStyle" TargetType="Label">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,16,0,6" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
  </Window.Resources>

  <StackPanel Margin="24">
    <TextBlock x:Name="HeadingText" Style="{StaticResource PageTitleTextStyle}" FontSize="20" />
    <TextBlock x:Name="InstructionText" Style="{StaticResource SecondaryTextStyle}" Margin="0,8,0,0" />

    <StackPanel x:Name="CurrentPanel">
      <Label Style="{StaticResource FieldLabelStyle}" Content="_Current PIN" Target="{Binding ElementName=CurrentBox}" />
      <PasswordBox x:Name="CurrentBox"
                   MaxLength="8"
                   InputMethod.IsInputMethodEnabled="False"
                   AutomationProperties.Name="Current PIN"
                   PreviewTextInput="OnPinTextInput" />
    </StackPanel>

    <StackPanel x:Name="NewPanel">
      <Label Style="{StaticResource FieldLabelStyle}" Content="_New PIN" Target="{Binding ElementName=NewBox}" />
      <PasswordBox x:Name="NewBox"
                   MaxLength="8"
                   InputMethod.IsInputMethodEnabled="False"
                   AutomationProperties.Name="New PIN"
                   PreviewTextInput="OnPinTextInput" />
      <Label Style="{StaticResource FieldLabelStyle}" Content="C_onfirm new PIN" Target="{Binding ElementName=ConfirmBox}" />
      <PasswordBox x:Name="ConfirmBox"
                   MaxLength="8"
                   InputMethod.IsInputMethodEnabled="False"
                   AutomationProperties.Name="Confirm new PIN"
                   PreviewTextInput="OnPinTextInput" />
    </StackPanel>

    <TextBlock x:Name="ErrorText"
               Style="{StaticResource BodyTextStyle}"
               Margin="0,12,0,0"
               AutomationProperties.LiveSetting="Assertive"
               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
               Visibility="Collapsed" />

    <StackPanel Margin="0,24,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
      <Button x:Name="SubmitButton"
              Style="{StaticResource AccentButtonStyle}"
              MinWidth="96"
              IsDefault="True"
              Click="OnSubmitClick" />
      <Button x:Name="CancelButton"
              MinWidth="96"
              Margin="8,0,0,0"
              Content="Cancel"
              IsCancel="True"
              AutomationProperties.Name="Cancel" />
    </StackPanel>
  </StackPanel>
</Window>
