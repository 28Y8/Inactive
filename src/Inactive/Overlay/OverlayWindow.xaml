<!-- The overlay sits on black or on arbitrary screen content in every theme, so unlike the rest of
     the app it uses its own fixed palette. The window background of alpha 1 is what makes the
     Visible style hit-testable: touch skips the mouse hook, so this window has to absorb it. -->
<Window x:Class="Inactive.Overlay.OverlayWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inactive lock screen"
        AutomationProperties.Name="Inactive lock screen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        WindowStartupLocation="Manual"
        Background="#01000000"
        FontFamily="Segoe UI"
        Stylus.IsPressAndHoldEnabled="False"
        Stylus.IsFlicksEnabled="False"
        Stylus.IsTapFeedbackEnabled="False"
        Stylus.IsTouchFeedbackEnabled="False">

  <Window.Resources>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#F21F1F1F" />
    <SolidColorBrush x:Key="SurfaceStrokeBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#CCFFFFFF" />
    <SolidColorBrush x:Key="DotEmptyBrush" Color="#66FFFFFF" />

    <Style x:Key="PillStyle" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource SurfaceStrokeBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Padding" Value="20,8" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
  </Window.Resources>

  <Grid TextElement.Foreground="#FFFFFFFF">
    <Border x:Name="Shade" Opacity="0" />

    <StackPanel x:Name="ClockBlock"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="Collapsed">
      <StackPanel.RenderTransform>
        <TranslateTransform x:Name="ClockDrift" />
      </StackPanel.RenderTransform>
      <!-- Keeps the text readable over bright content in the Dimmed style. -->
      <StackPanel.Effect>
        <DropShadowEffect BlurRadius="28" Color="Black" Opacity="0.95" ShadowDepth="0" />
      </StackPanel.Effect>
      <TextBlock x:Name="TimeText"
                 HorizontalAlignment="Center"
                 FontSize="120"
                 FontWeight="Light" />
      <TextBlock x:Name="DateText"
                 Margin="0,-4,0,0"
                 HorizontalAlignment="Center"
                 FontSize="24"
                 FontWeight="Light"
                 Foreground="{StaticResource SecondaryTextBrush}" />
      <TextBlock x:Name="MessageText"
                 MaxWidth="720"
                 Margin="0,32,0,0"
                 HorizontalAlignment="Center"
                 FontSize="24"
                 FontWeight="Light"
                 TextAlignment="Center"
                 TextWrapping="Wrap"
                 Visibility="Collapsed" />
      <TextBlock x:Name="HintText"
                 Margin="0,16,0,0"
                 HorizontalAlignment="Center"
                 FontSize="16"
                 Foreground="{StaticResource SecondaryTextBrush}"
                 Visibility="Collapsed" />
    </StackPanel>

    <StackPanel Margin="0,0,0,48" HorizontalAlignment="Center" VerticalAlignment="Bottom">
      <Border x:Name="AttemptPill" Style="{StaticResource PillStyle}" Opacity="0">
        <TextBlock FontSize="16" Text="This PC is locked" />
      </Border>
      <Border x:Name="ElevatedHintPill"
              Style="{StaticResource PillStyle}"
              Margin="0,8,0,0"
              Visibility="Collapsed">
        <TextBlock FontSize="16" Text="Press Ctrl + Alt + Del, choose Lock and sign in to unlock" />
      </Border>
      <Border x:Name="LockedPill"
              Style="{StaticResource PillStyle}"
              Margin="0,8,0,0"
              Visibility="Collapsed">
        <TextBlock x:Name="LockedPillText" FontSize="14" TextWrapping="Wrap" MaxWidth="600" />
      </Border>
    </StackPanel>

    <Border x:Name="PinPanel"
            Width="360"
            Padding="32,28"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource SurfaceStrokeBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Visibility="Collapsed">
      <Border.RenderTransform>
        <TranslateTransform x:Name="PinShake" />
      </Border.RenderTransform>
      <StackPanel>
        <TextBlock x:Name="PinTitle"
                   HorizontalAlignment="Center"
                   FontSize="20"
                   TextAlignment="Center"
                   TextWrapping="Wrap" />
        <StackPanel x:Name="PinDots"
                    Height="20"
                    Margin="0,24,0,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal" />
        <TextBlock x:Name="PinStatus"
                   MinHeight="20"
                   Margin="0,20,0,0"
                   HorizontalAlignment="Center"
                   AutomationProperties.LiveSetting="Polite"
                   FontSize="14"
                   Foreground="{StaticResource SecondaryTextBrush}"
                   TextAlignment="Center"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
